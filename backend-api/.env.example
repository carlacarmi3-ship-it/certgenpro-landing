# ============================================================
# .env.example — CertGen Pro Backend API
# Copy file ini menjadi .env.local untuk development lokal
# Di Vercel: isi semua variable ini di Settings → Environment Variables
# ============================================================

# ── SUPABASE ──
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx
# CATATAN: SUPABASE_SERVICE_KEY dan SUPABASE_SERVICE_ROLE_KEY diisi dengan nilai yang SAMA

# ── MIDTRANS (PRODUCTION) ──
# Login ke dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=Mid-server-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=Mid-client-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=true
# CATATAN: Untuk testing gunakan sandbox.midtrans.com dan set MIDTRANS_IS_PRODUCTION=false

# ── BREVO (Email) ──
# Login ke brevo.com → Settings → API Keys → Generate new key
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Email sender yang sudah diverifikasi di Brevo
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# ── FONNTE (WhatsApp) ──
# Login ke fonnte.com → Token
FONNTE_TOKEN=XXXXXXXXXXXXXXXXXXXX

# ── SECRETS ──
# Buat random string 32 karakter: openssl rand -hex 16
LICENSE_SECRET=ganti_dengan_32_karakter_random_rahasia
ADMIN_SECRET=ganti_dengan_password_admin_kuat
CRON_SECRET=ganti_dengan_secret_cron_job

# ── APP LINKS ──
APP_DOWNLOAD_LINK=https://drive.google.com/file/d/XXXXXX/view
APP_DOWNLOAD_LINK_MIRROR=https://www.mediafire.com/file/XXXXXX
SUPPORT_WA=6289627312600
# Format: 62 + nomor tanpa 0 di depan (628xxx)

# ── LANDING PAGE URL (untuk redirect Midtrans) ──
LANDING_URL=https://USERNAME.github.io/certgenpro-landing
# Atau domain custom Anda jika ada
